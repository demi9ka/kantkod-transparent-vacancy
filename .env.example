# Ключ авторизации (готовая Base64-строка из кабинета), без префикса Basic.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://api.giga.chat/v1
# При необходимости путь к PEM-файлу с доверенными сертификатами.
GIGACHAT_CA_BUNDLE=
SOURCE_URL=https://opendata.trudvsem.ru/api/v1/vacancies/region/39
MAX_VACANCIES=10
PAGE_SIZE=10
REQUEST_TIMEOUT=90
SCHEDULE_ENABLED=false
# Ежедневно в 09:00 по Калининграду; стандартные пять полей cron.
SCHEDULE_CRON=0 9 * * *
TIMEZONE=Europe/Kaliningrad
REPORT_PATH=reports/latest.json
# Относительный путь логов считается от корня проекта. Для отладки: LOG_LEVEL=DEBUG.
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=INFO
